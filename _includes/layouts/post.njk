---
layout: layouts/base.njk
---

<section class="article-container">
  <p class="breadcrumbs"><a href="../../{{ returnDestination | lower }}">Back to {{ returnDestination }}</a></p>  
  <div class="prose">
    {% if showDate %}
      <p>{{ date | readableDate(lang) }}</p>
    {% endif %}
    <h1>{{ title }}</h1>
    {{ content | safe }}
    {% if lastEdited %}
      <p><em>Last Edited: {{ lastEdited | readableDate(lang) }}</em></p>
    {% endif %}
  </div>
</section>