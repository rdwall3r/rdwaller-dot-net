---
layout: layouts/base.njk
---

<section class="article-container">
  <div class="content-section">
    <div class="return-link">
      <a href="../../{{ returnDestination | lower }}">Back to {{ returnDestination }}</a>
    </div>
    {% if showDate %}
    <div><time datetime="{{ page.date.toISOString().slice(0, 10) }}">{{ page.date | readableDate }}</time></div>
    {% endif %}
    {{ content | safe }}
  </div>
</section>