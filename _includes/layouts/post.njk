---
layout: layouts/base.njk
---

<section class="article-container">
  <div class="content-section">
    <p>
      <a href="../../{{ returnDestination | lower }}">Back to {{ returnDestination }}</a>
    </p>
    {% if showDate %}
      <p>{{ publishDate | readableDate }}</p>
    {% endif %}
    {{ content | safe }}
    {% if lastEdited %}
      <p><em>Last Edited: {{ lastEdited | readableDate }}</em></p>
    {% endif %}
  </div>
</section>