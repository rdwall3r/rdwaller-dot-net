<!doctype html>
<html lang="{{ lang }}">
  <head>
    <title>{{ title }}</title>
    <link rel="icon" type="image/svg+xml" href="/assets/icons/favicon.svg">
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://rdwaller.net{{ page.url }}" />
    <meta property="og:title" content="{{ title }}" />
    <meta property="og:description" content="{{ description or 'A place to publish writing and projects at the intersection of development and universal design.' }}" />
    {% set socialImage = ogImage if ogImage is defined else '/assets/profile-pics/parkville_brick_small.jpg' %}
    {% if socialImage %}
      <meta property="og:image" content="https://rdwaller.net{{ socialImage }}" />
    {% endif %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible+Next:ital,wght@0,200..800;1,200..800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css" />
    <script src="/js/nav.js" defer></script>
  </head>
  <body>
    <div id="skip">
      <a href="#main-content">Skip to main content</a>
    </div>
    <header>
      <div id="site-id-container">
        <a href="/"{% if page.url == "/" %} aria-current="page"{% endif %}>
          <div id="site-id">Ryan Waller</div>
        </a>
        <div id="tag-line">At the intersection of <strong>development</strong> and <strong>universal design</strong></div>
      </div>
      <nav id="main-nav" aria-label="Primary navigation">
        <ul>
          <li><a href="/writing/" data-label="Writing"{% if page.url.startsWith("/writing/") or page.url.startsWith("/reading/") %} aria-current="page"{% endif %}><span>Writing</span></a></li>
          <li><a href="/projects/" data-label="Projects"{% if page.url.startsWith("/projects/") %} aria-current="page"{% endif %}><span>Projects</span></a></li>
          <li><a href="/contact/" data-label="Contact"{% if page.url.startsWith("/contact/") %} aria-current="page"{% endif %}><span>Contact</span></a></li>
        </ul>
      </nav>
    </header>
    <main id="main-content">
      {{ content | safe }}
    </main>
    <footer id="base-footer">
      <ul class="social-links">
        <li>
          <a href="https://www.linkedin.com/in/rdwaller/">
            <img
              class="icon-medium"
              src="/assets/icons/InBug-Black.svg"
              alt="LinkedIn profile"
            />
          </a>
        </li>
        <li>
          <a href="https://github.com/rdwall3r">
            <img
              class="icon-medium"
              src="/assets/icons/GitHub_Invertocat_Black.svg"
              alt="GitHub profile"
            />
          </a>
        </li>
        <li>
          <a href="mailto:rdwaller@rdwaller.net">
            <img
              class="icon-medium"
              src="/assets/icons/heroicons/envelope-solid.svg"
              alt="Email Ryan"
            />
          </a>
        </li>
      </ul>
    </footer>
  </body>
</html>
