<!doctype html>
<html lang="en">
  <head>
    <title>{{ title }}</title>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=5"
    />
    <link rel="stylesheet" href="/css/style.css" />
    <script src="/js/nav.js" defer></script>
  </head>
  <body>
    <header>
      <div id="site-id-container">
        <div id="site-id">Ryan Waller</div>
        <div id="tag-line">At the intersection of development and universal design</div>
      </div>
      <nav id="main-nav" aria-label="Primary navigation">
        <ul>
          <li><a href="/" data-label="Home"{% if page.url == "/" %} aria-current="page"{% endif %}><span>Home</span></a></li>
          <li><a href="/projects/" data-label="Projects"{% if page.url.startsWith("/projects/") %} aria-current="page"{% endif %}><span>Projects</span></a></li>
          <li><a href="/writing/" data-label="Writing"{% if page.url.startsWith("/writing/") %} aria-current="page"{% endif %}><span>Writing</span></a></li>
          <li><a href="/contact/" data-label="Contact"{% if page.url.startsWith("/contact/") %} aria-current="page"{% endif %}><span>Contact</span></a></li>
        </ul>
      </nav>
    </header>
    <main>
      {{ content | safe }}
    </main>
    <footer>
      <ul class="social-links">
        <li>
          <a
            href="https://www.linkedin.com/in/rdwaller/"
            aria-label="Ryan's LinkedIn profile"
          >
            <img
              class="footer-icon"
              src="/assets/icons/InBug-Black.svg"
              alt="Link to Ryan's LinkedIn profile"
            />
          </a>
        </li>
        <li>
          <a href="https://github.com/rdwall3r" aria-label="Ryan's GitHub profile">
            <img
              class="footer-icon"
              src="/assets/icons/GitHub_Invertocat_Black.svg"
              alt="Link to Ryan's GitHub profile"
            />
          </a>
        </li>
        <li>
          <a href="mailto:rdwaller@rdwaller.net" aria-label="Email Ryan">
            <img
              class="footer-icon"
              src="/assets/icons/heroicons/envelope-solid.svg"
              alt="Email Ryan"
            />
          </a>
        </li>
      </ul>
    </footer>
  </body>
</html>
