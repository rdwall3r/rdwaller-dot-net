---
layout: layouts/base.njk
---

<section class="article-container">
  <div class="content-section">
    <p>
      <h1>Writing</h1>
      <ul class="post-list">
        {% for post in collections.writing | reverse %}
          <li>
            <a href="{{ post.url }}">{{ post.data.title }}</a>
            {% if post.data.showDate %}
              <time datetime="{{ post.data.publishDate | isoDate }}">({{ post.data.publishDate | readableDate }})</time>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    </p>
    <p>
      {% set readingList = collections.reading[0] %}
      <a class="link-with-icon" href="{{ readingList.url }}">
        {{ readingList.data.title }}
        <img
          alt=""
          class="icon-small"
          src="/assets/icons/heroicons/book-open-solid.svg"
        />
      </a>
    </p>
  </div>
</section>
