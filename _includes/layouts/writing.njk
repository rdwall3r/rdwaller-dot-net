---
layout: layouts/base.njk
---

<section class="article-container">
  <div class="content-section">
    <h1>Writing</h1>
      <ul class="post-list">
        {% for post in collections.writing | reverse %}
          <li>
            <div class="post-item">
              <a href="{{ post.url }}">{{ post.data.title }}</a>
              <time datetime="{{ post.date.toISOString().slice(0, 10) }}">({{ post.date | readableDate }})</time>
            </div>
          </li>
        {% endfor %}
      </ul>
    <h1>Reading List</h1>
      <ul class="post-list">
        {% for post in collections.reading | reverse %}
          <li>
            <div class="post-item">
              <a href="{{ post.url }}">{{ post.data.title }}</a>
              <time datetime="{{ post.date.toISOString().slice(0, 10) }}">({{ post.date | readableDate }})</time>
            </div>
          </li>
        {% endfor %}
      </ul>
  </div>
</section>
